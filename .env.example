# 環境変数の設定例
#
# ガイド: このファイルをコピーして .env を作成し、値を設定してください。
#   cp .env.example .env
#
# 詳細は docs/dev/config-reference.md を参照してください。

# アプリケーション
APP_PORT=3000
LOG_LEVEL=info
NODE_ENV=development

# データベース（該当する場合）
# DATABASE_URL=postgresql://{user}:{password}@localhost:5432/{dbname}

# 外部 API（該当する場合）
# API_KEY={APIキーをここに設定}
